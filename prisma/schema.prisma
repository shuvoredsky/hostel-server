generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  OWNER
  STUDENT
  TENANT
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Profession {
  SOFTWARE_ENGINEER
  DOCTOR
  TEACHER
  BANKER
  FREELANCER
  BUSINESS
  OTHERS
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  emailVerified       Boolean              @default(false)
  image               String?
  whatsappNumber      String?
  tenantType          TenantType?
  role                Role                 @default(STUDENT)
  status              UserStatus           @default(ACTIVE)
  needPasswordChange  Boolean              @default(false)
  gender              Gender?
  profession          Profession?
  studentVerification StudentVerification?
  isDeleted           Boolean              @default(false)
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  sessions Session[]
  accounts Account[]
  listings Listing[]
  reviews  Review[]

  // Booking relations
  studentBookings Booking[] @relation("StudentBookings")
  ownerBookings   Booking[] @relation("OwnerBookings")

  // Payment relation
  payments  Payment[]  @relation("StudentPayments")
  bookings  Booking[]
  wishlist  Wishlist[] @relation("StudentWishlist")
  wishlists Wishlist[]

  studentConversations Conversation[] @relation("StudentConversations")
  ownerConversations   Conversation[] @relation("OwnerConversations")
  sentMessages         Message[]      @relation("SentMessages")
  conversations        Conversation[]
  messages             Message[]
}

model StudentVerification {
  id               String                    @id @default(cuid())
  userId           String                    @unique
  studentIdCardUrl String
  universityName   String
  department       String
  session          String
  status           StudentVerificationStatus @default(PENDING)
  rejectionReason  String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  expiresAt             DateTime?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum ListingType {
  ROOM
  SEAT
  BASHA
}

enum TenantType {
  JOB_HOLDER
  FREELANCER
  INTERN
  BUSINESS_PERSON
  FAMILY
  OTHERS
}

enum StudentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdvanceOption {
  NO_ADVANCE
  ONE_MONTH
  TWO_MONTH
}

enum GenderPreference {
  BOYS
  GIRLS
  FAMILY
  ANYONE
}

enum Amenity {
  WIFI
  FILTERED_WATER
  AC
  LIFT
  SECURITY_24_7
  CCTV
  PARKING
}

enum GasType {
  CYLINDER
  SUPPLY
  NOT_AVAILABLE
}

enum NearbyLandmarkType {
  UNIVERSITY
  METRO_STATION
  BUS_STOP
}

model Listing {
  id          String        @id @default(cuid())
  title       String
  description String
  type        ListingType
  status      ListingStatus @default(PENDING)
  price       Float
  address     String
  area        String
  city        String        @default("Dhaka")
  totalRooms  Int?
  totalSeats  Int?
  isAvailable Boolean       @default(true)
  isDeleted   Boolean       @default(false)
  googleMapsLink String?

  studentDiscountPercent Int?                @default(0) // 0, 5, 10, 15
  advanceOption          AdvanceOption       @default(TWO_MONTH)
  genderPreference       GenderPreference    @default(ANYONE)
  allowHalfMonthlyPay    Boolean             @default(false)
  amenities              Amenity[]           @default([])
  gasType                GasType?            @default(NOT_AVAILABLE)
  nearbyType             NearbyLandmarkType?
  nearbyName             String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  images   ListingImage[]
  bookings Booking[]
  reviews  Review[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  wishlists Wishlist[]

  @@index([status, isDeleted])
  @@index([area])
  @@index([city])
  @@index([price])
}

model ListingImage {
  id        String   @id @default(cuid())
  url       String
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CONFIRMED
  CANCELLED
}

enum PaymentPlan {
  FULL
  HALF_MONTHLY
}

model Booking {
  id         String        @id @default(cuid())
  listingId  String
  studentId  String
  ownerId    String
  status     BookingStatus @default(PENDING)
  message    String?
  moveInDate DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  listing      Listing       @relation(fields: [listingId], references: [id])
  student      User          @relation("StudentBookings", fields: [studentId], references: [id])
  owner        User          @relation("OwnerBookings", fields: [ownerId], references: [id])
  payment      Payment?
  paymentPlan  PaymentPlan   @default(FULL)
  user         User?         @relation(fields: [userId], references: [id])
  userId       String?
  extraCharges ExtraCharge[]
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  listingId String
  studentId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id])
  student User    @relation(fields: [studentId], references: [id])
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

model PaymentInstallment {
  id            String            @id @default(cuid())
  paymentId     String
  installmentNo Int
  amount        Float
  commission    Float             @default(0)
  dueDate       DateTime?
  status        InstallmentStatus @default(PENDING)
  transactionId String?           @unique
  paidAt        DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id              String               @id @default(cuid())
  bookingId       String               @unique
  studentId       String
  amount          Float
  commission      Float
  currency        String               @default("BDT")
  status          PaymentStatus        @default(UNPAID)
  originalAmount  Float?
  discountPercent Int?                 @default(0)
  discountAmount  Float?               @default(0)
  transactionId   String?              @unique
  sslSessionKey   String?
  paidAt          DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  installments    PaymentInstallment[]

  booking Booking @relation(fields: [bookingId], references: [id])
  student User    @relation("StudentPayments", fields: [studentId], references: [id])
}

model ExtraCharge {
  id          String   @id @default(cuid())
  bookingId   String
  title       String
  amount      Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Wishlist {
  id        String   @id @default(cuid())
  studentId String
  listingId String
  createdAt DateTime @default(now())

  student User    @relation("StudentWishlist", fields: [studentId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])
  userId  String?

  @@unique([studentId, listingId])
}

model SiteSettings {
  id        String   @id @default(cuid())
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteBanner {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id        String   @id @default(cuid())
  studentId String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student  User      @relation("StudentConversations", fields: [studentId], references: [id])
  owner    User      @relation("OwnerConversations", fields: [ownerId], references: [id])
  messages Message[]
  user     User?     @relation(fields: [userId], references: [id])
  userId   String?

  @@unique([studentId, ownerId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  userId       String?
}
